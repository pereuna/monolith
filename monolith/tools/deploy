#!/bin/bash
# The wasm32 machine's page (tools/pages) installed in the Plan2001 CPU
# VM, which then serves it itself: https://127.0.0.1:17443/ (rc-httpd
# behind tlssrv, webterm's wss on the same origin; docs/architecture.md,
# D7).  Restarts the VM.
#   tools/deploy        CPU_CERT_SANS as for ../tools/vm-cpu
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
"$root/tools/pages" "$root/build/deploy"
"$(dirname "$root")/tools/vm-cpu" --update --web "$root/build/deploy"
echo "deploy: https://127.0.0.1:17443/"
