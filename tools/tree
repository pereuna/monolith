#!/bin/bash
# The tree: 9front's release as the repo has it (subset/9front) with
# Plan2001's kernel tree and this repo's plan2001/ laid over it - new files,
# and 9front's files they change, whole.  The tree in 9front's root layout: /sys,
# /rc, /$objtype ... - the native build here (tools/native-wasm32).
#   tools/tree [DIR]     default build/tree, made anew
set -e
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$here")
out=${1:-$root/build/tree}
rm -rf "$out"; mkdir -p "$out"
cp -a "$root/subset/9front/." "$out/"
# Plan2001's kernel tree (PLAN2001, default ~/Plan2001), then this repo's
# plan2001/ over both: the git-tracked files only
P2=${PLAN2001:-$HOME/Plan2001}
(cd "$P2/plan2001" && git ls-files | tar cf - -T -) | tar xf - -C "$out"
(cd "$root/plan2001" && git ls-files | tar cf - -T -) | tar xf - -C "$out"
# what the release ships made from another file (libsec's X.c and
# libauthsrv's X.mpc from X.mp, by mpc) newer than it, as on a 9front machine: a checkout's mtimes are
# in any order, and mk would make it again with a tool the host lacks
find "$out" -name '*.mp' | while read -r m; do
	for g in "${m%.mp}.c" "${m}c"; do [ ! -e "$g" ] || touch "$g"; done
done
echo "tree: $out ($(cd "$root/plan2001" && git ls-files | wc -l) files of plan2001/)"
